<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@APP_TITLE@</title>
<link rel="icon" href="data:,">
<style>
  html, body { margin: 0; height: 100%; background: #000; color: #ccc; overflow: hidden; }
  body { font: 14px/1.5 system-ui, sans-serif; }
  canvas { display: block; width: 100%; height: 100%; outline: none; }
  #status { position: fixed; inset: 0; display: grid; place-items: center; text-align: center; padding: 16px;
            pointer-events: none; white-space: pre-line; }
</style>
</head>
<body>
<canvas id="canvas" tabindex="-1"></canvas>
<div id="status">Loading…</div>
<script>
  // Hyoshi web build. The WebGPU device is requested here, before the module starts, because
  // adapter and device requests are asynchronous; the engine picks it up through
  // Module.preinitializedWebGPUDevice. Without one (an older browser, a car's), the engine draws
  // with WebGL 2 instead; ?renderer=webgl (or HYOSHI_RENDERER=webgl) picks it anyway. Settings in
  // the URL (?HYOSHI_AUTOPLAY=1) become environment variables (pre.js).
  const statusText = document.getElementById("status");
  const fail = (message) => { statusText.textContent = message; console.error(message); };

  (async () => {
    // Threads need SharedArrayBuffer, which needs the page served with COOP and COEP headers.
    if (!crossOriginIsolated) {
      return fail("This page isn't cross-origin isolated, so the game can't start its threads.\n" +
                  "The server must send Cross-Origin-Opener-Policy: same-origin and\n" +
                  "Cross-Origin-Embedder-Policy: require-corp for this page.");
    }
    const params = new URLSearchParams(location.search);
    const renderer = (params.get("renderer") ?? params.get("HYOSHI_RENDERER") ?? "").toLowerCase();
    let device = null;
    if (navigator.gpu && renderer !== "webgl") {
      try {
        const adapter = await navigator.gpu.requestAdapter();
        device = adapter ? await adapter.requestDevice() : null;
      } catch (error) {
        console.warn("No WebGPU device, so WebGL 2:", error);
        device = null;
      }
    }
    if (!device && !document.createElement("canvas").getContext("webgl2")) {
      return fail("This browser supports neither WebGPU nor WebGL 2.");
    }

    window.Module = {
      canvas: document.getElementById("canvas"),
      webgpuErrorCount: 0,
      setStatus: (text) => { if (text) statusText.textContent = text; },
      onRuntimeInitialized: () => { statusText.textContent = ""; },
      onAbort: (what) => fail("The game stopped: " + what),
    };
    if (device) {
      window.Module.preinitializedWebGPUDevice = device;
      device.lost.then((info) => fail("The WebGPU device was lost: " + info.message));
      device.addEventListener("uncapturederror", (event) => {
        window.Module.webgpuErrorCount++;
        console.error("WebGPU:", event.error.message);
      });
    }

    const script = document.createElement("script");
    script.src = "@APP_OUTPUT_NAME@.js";
    script.onerror = () => fail("Could not load @APP_OUTPUT_NAME@.js");
    document.body.appendChild(script);
  })();
</script>
</body>
</html>
